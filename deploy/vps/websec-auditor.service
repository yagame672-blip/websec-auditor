[Unit]
Description=websec-auditor Grounded Security Scanner UI
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/websec-auditor
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /opt/websec-auditor/websec_cli.py webui --port 8000
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/websec-auditor/data

[Install]
WantedBy=multi-user.target
